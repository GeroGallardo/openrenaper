# ==============================================================================
# OpenRENAPER: configuración de entorno
# Copiá este archivo a .env y completá las URL de las fuentes.
# ==============================================================================

# --- Fuentes de datos ---------------------------------------------------------
# Cada fuente es una página web pública que se consulta en el momento.
# La URL es una plantilla: {numero} se reemplaza por el DNI o CUIT/CUIL, solo dígitos.
# Una fuente sin URL queda deshabilitada. Pedile las URL al equipo de OpenRENAPER.
OPENRENAPER_PAG_WEB1_URL=
OPENRENAPER_PAG_WEB2_URL=

# --- Servidor HTTP --------------------------------------------------------------
# Puerto publicado en el host por Docker Compose.
OPENRENAPER_PORT=8000
# Procesos de uvicorn. Cada uno abre su propio Chromium: empezá con 1.
WEB_CONCURRENCY=1
# Proxies autorizados a enviar X-Forwarded-For/Proto (separados por coma). No usar *.
OPENRENAPER_PROXIES_CONFIABLES=127.0.0.1

# --- Límite de peticiones (en memoria, por proceso, rutas /api/) -------------------
OPENRENAPER_RATE_LIMIT_HABILITADO=true
OPENRENAPER_RATE_LIMIT_POR_IP=15
OPENRENAPER_RATE_LIMIT_TOTAL=30
OPENRENAPER_RATE_LIMIT_VENTANA_SEGUNDOS=60
OPENRENAPER_RATE_LIMIT_MAX_EN_CURSO=4

# --- Registro --------------------------------------------------------------------
# Logs JSON con método, ruta, estado, duración y contadores.
OPENRENAPER_LOG_SOLICITUDES=true
OPENRENAPER_LOG_HEALTH=false

# --- Plazos generales -------------------------------------------------------------
# Tiempo máximo para resolver una consulta entre todas las fuentes (segundos).
OPENRENAPER_TIEMPO_LIMITE_PROVEEDOR=45.0

# --- pag_web1 ---------------------------------------------------------------------
OPENRENAPER_PAG_WEB1_HABILITADO=true
OPENRENAPER_PAG_WEB1_MAX_CONCURRENTES=2
# Espera mínima entre solicitudes a la fuente, por proceso (segundos).
OPENRENAPER_PAG_WEB1_INTERVALO_MINIMO=2.0
# Intentos ante errores transitorios, incluido el primero.
OPENRENAPER_PAG_WEB1_INTENTOS=2
OPENRENAPER_PAG_WEB1_TIEMPO_SOLICITUD=30.0
OPENRENAPER_PAG_WEB1_TIEMPO_TOTAL=40.0
OPENRENAPER_PAG_WEB1_ESPERA_BASE=0.5

# --- pag_web2 ---------------------------------------------------------------------
OPENRENAPER_PAG_WEB2_HABILITADO=true
# 'navegador' (Chromium con Playwright) o 'http'. La fuente necesita JavaScript.
OPENRENAPER_PAG_WEB2_MODO=navegador
OPENRENAPER_PAG_WEB2_MAX_CONCURRENTES=2
OPENRENAPER_PAG_WEB2_INTERVALO_MINIMO=2.0
OPENRENAPER_PAG_WEB2_INTENTOS=3
OPENRENAPER_PAG_WEB2_TIEMPO_SOLICITUD=30.0
OPENRENAPER_PAG_WEB2_TIEMPO_TOTAL=40.0
OPENRENAPER_PAG_WEB2_ESPERA_BASE=0.5

# --- Recursos del contenedor (Docker Compose) -------------------------------------
OPENRENAPER_CPU_LIMIT=2.0
OPENRENAPER_MEMORY_LIMIT=2G
OPENRENAPER_CPU_RESERVATION=0.5
OPENRENAPER_MEMORY_RESERVATION=512M
